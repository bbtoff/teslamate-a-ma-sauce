    {
      "id": 3,
      "type": "stat",
      "title": "Taille totale",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT sum(pg_total_relation_size(relid)) FROM pg_catalog.pg_statio_user_tables) AS \"Taille\",\n  regexp_replace(version(), 'PostgreSQL ([^ ]+) .*', '\\1') AS \"PostgreSQL\", current_setting('TimeZone') AS \"Fuseau\",\n  (SELECT count(*) FROM cars) AS \"Voitures\",\n  (SELECT count(*) FROM drives WHERE car_id = $car_id) AS \"Trajets\", (SELECT count(*) FROM charging_processes WHERE car_id = $car_id) AS \"Recharges\",\n  (SELECT count(*) FROM drives WHERE car_id = $car_id AND end_date IS NULL) AS \"Trajets ouverts\",\n  (SELECT count(*) FROM charging_processes WHERE car_id = $car_id AND end_date IS NULL) AS \"Recharges ouvertes\",\n  (SELECT count(*) FROM updates WHERE car_id = $car_id) AS \"Mises à jour\"",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Taille$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6E7580",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
