    {
      "id": 16,
      "type": "stat",
      "title": "Dernier trajet",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(timezone('$__timezone', timezone('UTC', d.start_date)), 'DD/MM HH24:MI') || ' · ' || COALESCE(sg.name, CONCAT_WS(', ', COALESCE(sa.name, NULLIF(CONCAT_WS(' ', sa.road, sa.house_number), '')), COALESCE(sa.city, sa.neighbourhood))) || ' → ' || COALESCE(eg.name, CONCAT_WS(', ', COALESCE(ea.name, NULLIF(CONCAT_WS(' ', ea.road, ea.house_number), '')), COALESCE(ea.city, ea.neighbourhood)))\n  || ' · ' || round(d.distance::numeric, 1) || ' km · ' ||\n  round(((d.start_${preferred_range}_range_km - d.end_${preferred_range}_range_km) * car.efficiency * 100 / nullif(d.distance, 0))::numeric, 1) || ' kWh/100 km' AS \"Résumé\"\nFROM drives d JOIN cars car ON car.id = d.car_id\n  LEFT JOIN addresses sa ON sa.id = d.start_address_id LEFT JOIN addresses ea ON ea.id = d.end_address_id\n  LEFT JOIN geofences sg ON sg.id = d.start_geofence_id LEFT JOIN geofences eg ON eg.id = d.end_geofence_id\n  LEFT JOIN positions sp ON sp.id = d.start_position_id LEFT JOIN positions ep ON ep.id = d.end_position_id WHERE d.car_id = $car_id AND d.end_date IS NOT NULL ORDER BY d.start_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Résumé$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3274D9",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Dernière recharge",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(timezone('$__timezone', timezone('UTC', cp.start_date)), 'DD/MM HH24:MI') || ' · ' || COALESCE(g.name, CONCAT_WS(', ', COALESCE(a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), '')), COALESCE(a.city, a.neighbourhood))) || ' · ' ||\n  cp.start_battery_level || ' → ' || cp.end_battery_level || ' % · ' || round(cp.charge_energy_added, 1) || ' kWh'\n  || COALESCE(' · ' || round(cp.cost, 2) || ' €', '') AS \"Résumé\"\nFROM charging_processes cp LEFT JOIN addresses a ON a.id = cp.address_id LEFT JOIN geofences g ON g.id = cp.geofence_id\nWHERE cp.car_id = $car_id AND cp.end_date IS NOT NULL AND cp.charge_energy_added > 0 ORDER BY cp.start_date DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
