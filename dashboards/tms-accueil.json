    {
      "id": 10,
      "type": "stat",
      "title": "Distance",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH dr AS (SELECT d.*, car.efficiency FROM drives d JOIN cars car ON car.id = d.car_id WHERE d.car_id = $car_id AND d.start_date >= date_trunc('month', timezone('$__timezone', now()))::timestamp AT TIME ZONE '$__timezone' AT TIME ZONE 'UTC' AND d.end_date IS NOT NULL),\nch AS (SELECT cp.* FROM charging_processes cp WHERE cp.car_id = $car_id AND cp.start_date >= date_trunc('month', timezone('$__timezone', now()))::timestamp AT TIME ZONE '$__timezone' AT TIME ZONE 'UTC' AND cp.end_date IS NOT NULL AND cp.charge_energy_added > 0)\nSELECT (SELECT sum(distance) FROM dr) AS \"Distance\", (SELECT count(*) FROM dr) AS \"Trajets\",\n  (SELECT sum((start_${preferred_range}_range_km - end_${preferred_range}_range_km) * efficiency) * 100 / nullif(sum(distance), 0) FROM dr) AS \"Conso\",\n  (SELECT count(*) FROM ch) AS \"Recharges\", (SELECT sum(charge_energy_added) FROM ch) AS \"kWh\", (SELECT sum(cost) FROM ch) AS \"Coût\"",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Distance$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
