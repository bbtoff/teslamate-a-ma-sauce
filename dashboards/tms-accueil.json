    {
      "id": 3,
      "type": "gauge",
      "title": "Batterie",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT battery_level FROM positions WHERE car_id = $car_id AND battery_level IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Batterie\", (SELECT ${preferred_range}_battery_range_km FROM positions WHERE car_id = $car_id AND ${preferred_range}_battery_range_km IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Autonomie\",\n  (SELECT odometer FROM positions WHERE car_id = $car_id AND odometer IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Odomètre\", (SELECT outside_temp FROM positions WHERE car_id = $car_id AND outside_temp IS NOT NULL ORDER BY date DESC LIMIT 1) AS \"Temp. ext.\",\n  (SELECT state::text FROM states WHERE car_id = $car_id ORDER BY start_date DESC LIMIT 1) AS \"État\",\n  (SELECT extract(epoch FROM start_date) * 1000 FROM states WHERE car_id = $car_id ORDER BY start_date DESC LIMIT 1) AS \"Depuis\",\n  (SELECT split_part(version, ' ', 1) FROM updates WHERE car_id = $car_id ORDER BY start_date DESC LIMIT 1) AS \"Version\",\n  (SELECT CASE WHEN d.end_date IS NULL THEN '🚗 En route' ELSE COALESCE(g.name, CONCAT_WS(', ', COALESCE(a.name, NULLIF(CONCAT_WS(' ', a.road, a.house_number), '')), COALESCE(a.city, a.neighbourhood))) END FROM drives d\n     LEFT JOIN addresses a ON a.id = d.end_address_id LEFT JOIN geofences g ON g.id = d.end_geofence_id\n     WHERE d.car_id = $car_id ORDER BY d.start_date DESC LIMIT 1) AS \"Lieu\",\n  (SELECT end_date IS NULL FROM charging_processes WHERE car_id = $car_id ORDER BY start_date DESC LIMIT 1) AS \"En charge\"",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Batterie$/",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "minVizHeight": 75,
        "minVizWidth": 75,
        "sizing": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C4162A",
                "value": null
              },
              {
                "color": "#E0752D",
                "value": 20
              },
              {
                "color": "#56A64B",
                "value": 35
              },
              {
                "color": "#3274D9",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      }
    },
