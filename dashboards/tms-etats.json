    {
      "id": 3,
      "type": "stat",
      "title": "État actuel",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH w AS (SELECT $__timeFrom()::timestamp AS t0, LEAST($__timeTo()::timestamp, now() AT TIME ZONE 'UTC') AS t1),\nst AS (SELECT x.state, sum(extract(epoch FROM LEAST(COALESCE(x.end_date, w.t1), w.t1) - GREATEST(x.start_date, w.t0))) AS s FROM states x, w WHERE x.car_id = $car_id AND x.start_date < w.t1 AND COALESCE(x.end_date, w.t1) > w.t0 GROUP BY 1)\nSELECT (SELECT state::text FROM states WHERE car_id = $car_id ORDER BY start_date DESC LIMIT 1) AS \"État\",\n  (SELECT extract(epoch FROM start_date) * 1000 FROM states WHERE car_id = $car_id ORDER BY start_date DESC LIMIT 1) AS \"Depuis\",\n  (SELECT s FROM st WHERE state = 'asleep') / nullif((SELECT sum(s) FROM st), 0) * 100 AS \"Endormie\",\n  (SELECT count(*) FROM states x, w WHERE x.car_id = $car_id AND x.state = 'online' AND x.start_date BETWEEN w.t0 AND w.t1)\n    / GREATEST(extract(epoch FROM (SELECT t1 - t0 FROM w)) / 86400, 1) AS \"Réveils par jour\",\n  (SELECT count(*) FROM states x, w WHERE x.car_id = $car_id AND x.state = 'offline' AND x.start_date BETWEEN w.t0 AND w.t1) AS \"Hors ligne\"",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^État$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#6E7580"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5B6E8C",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "online": {
                  "text": "Éveillée",
                  "color": "#E0752D",
                  "index": 0
                },
                "asleep": {
                  "text": "Endormie",
                  "color": "#8F3BB8",
                  "index": 1
                },
                "offline": {
                  "text": "Hors ligne",
                  "color": "#6E7580",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
