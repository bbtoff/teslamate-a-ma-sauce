          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH w AS (SELECT $__timeFrom()::timestamp AS t0, LEAST($__timeTo()::timestamp, now() AT TIME ZONE 'UTC') AS t1),\nst AS (SELECT x.state, sum(extract(epoch FROM LEAST(COALESCE(x.end_date, w.t1), w.t1) - GREATEST(x.start_date, w.t0))) AS s FROM states x, w WHERE x.car_id = $car_id AND x.start_date < w.t1 AND COALESCE(x.end_date, w.t1) > w.t0 GROUP BY 1),\ndr AS (SELECT sum(extract(epoch FROM LEAST(COALESCE(x.end_date, w.t1), w.t1) - GREATEST(x.start_date, w.t0))) AS s FROM drives x, w WHERE x.car_id = $car_id AND x.start_date < w.t1 AND COALESCE(x.end_date, w.t1) > w.t0),\nch AS (SELECT sum(extract(epoch FROM LEAST(COALESCE(x.end_date, w.t1), w.t1) - GREATEST(x.start_date, w.t0))) AS s FROM charging_processes x, w WHERE x.car_id = $car_id AND x.start_date < w.t1 AND COALESCE(x.end_date, w.t1) > w.t0)\nSELECT 'Endormie' AS metric, (SELECT s FROM st WHERE state = 'asleep') AS value\nUNION ALL SELECT 'Hors ligne', (SELECT s FROM st WHERE state = 'offline')\nUNION ALL SELECT 'Conduite', (SELECT s FROM dr)\nUNION ALL SELECT 'Recharge', (SELECT s FROM ch)\nUNION ALL SELECT 'Éveillée garée', GREATEST((SELECT s FROM st WHERE state = 'online') - COALESCE((SELECT s FROM dr), 0) - COALESCE((SELECT s FROM ch), 0), 0)",
