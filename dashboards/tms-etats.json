/a><a href=\"/d/tms-pertes?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#A352CC33;border:1px solid #A352CC;\">🧛&nbsp;Pertes&nbsp;à&nbsp;l'arrêt</a><a href=\"/d/tms-temperatures?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#A352CC33;border:1px solid #A352CC;\">🌡️&nbsp;Températures</a><span style=\"width:10px\"></span><a href=\"/d/tms-lieux?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#1F9FAA33;border:1px solid #1F9FAA;\">📍&nbsp;Lieux</a><a href=\"/d/tms-visites?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#1F9FAA33;border:1px solid #1F9FAA;\">🗺️&nbsp;Visites</a><span style=\"width:10px\"></span><a href=\"/d/tms-statistiques?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#6E758033;border:1px solid #6E7580;\">🗓️&nbsp;Statistiques</a><a href=\"/d/tms-mises-a-jour?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#6E758033;border:1px solid #6E7580;\">⬆️&nbsp;Mises&nbsp;à&nbsp;jour</a><a href=\"/d/tms-base?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#6E758033;border:1px solid #6E7580;\">🗄️&nbsp;Base&nbsp;de&nbsp;données</a></div>"
