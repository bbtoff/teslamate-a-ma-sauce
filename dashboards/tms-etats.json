        "content": "<div style=\"display:flex;flex-wrap:wrap;align-items:center;justify-content:center\"><a href=\"/d/tms-accueil?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#5B6E8C33;border:1px solid #5B6E8C;\">🏠&nbsp;Accueil</a><a href=\"/d/tms-vue?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#5B6E8C33;border:1px solid #5B6E8C;\">📟&nbsp;Vue&nbsp;d'ensemble</a><a href=\"/d/tms-chronologie?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#5B6E8C33;border:1px solid #5B6E8C;\">🕒&nbsp;Chronologie</a><a href=\"/d/tms-etats?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#5B6E8C;border:1px solid #5B6E8C;font-weight:600;box-shadow:0 0 0 2px #5B6E8C55;\">💤&nbsp;États</a><span style=\"width:10px\"></span><a href=\"/d/tms-trajets?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#3274D933;border:1px solid #3274D9;\">🚗&nbsp;Trajets</a><a href=\"/d/tms-stats-conduite?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#3274D933;border:1px solid #3274D9;\">📈&nbsp;Stats&nbsp;conduite</a><a href=\"/d/tms-voyage?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3px;padding:3px 10px;border-radius:14px;font-size:12px;text-decoration:none;color:#fff;background:#3274D933;border:1px solid #3274D9;\">🧳&nbsp;Voyage</a><a href=\"/d/tms-kilometrage?${car_id:queryparam}\" style=\"display:inline-block;margin:2px 3