          "rawSql": "WITH s AS (SELECT battery_level AS b, extract(epoch FROM lead(date) OVER (ORDER BY date) - date) AS dt\n      FROM positions WHERE car_id = $car_id AND $__timeFilter(date) AND battery_level IS NOT NULL)\nSELECT (floor(LEAST(b, 99) / 10) * 10)::int || '–' || (floor(LEAST(b, 99) / 10) * 10 + 10)::int || ' %' AS \"Niveau\", sum(dt) / 3600 AS \"Heures\"\nFROM s WHERE dt < 172800 GROUP BY floor(LEAST(b, 99) / 10) ORDER BY floor(LEAST(b, 99) / 10)",
          "refId": "A"
