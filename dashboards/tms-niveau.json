    {
      "id": 3,
      "type": "stat",
      "title": "Niveau moyen",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "TeslaMate"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "TeslaMate"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (SELECT battery_level AS b, extract(epoch FROM lead(date) OVER (ORDER BY date) - date) AS dt\n      FROM positions WHERE car_id = $car_id AND $__timeFilter(date) AND battery_level IS NOT NULL)\nSELECT sum(b * dt) / nullif(sum(dt), 0) AS \"Moyenne\", sum(dt) FILTER (WHERE b BETWEEN 20 AND 80) / nullif(sum(dt), 0) * 100 AS \"Entre 20 et 80\",\n  sum(dt) FILTER (WHERE b > 90) / nullif(sum(dt), 0) * 100 AS \"Au-dessus de 90\", sum(dt) FILTER (WHERE b < 20) / nullif(sum(dt), 0) * 100 AS \"Sous 20\"\nFROM s WHERE dt < 172800",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Moyenne$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true,
        "orientation": "auto",
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C4162A",
                "value": null
              },
              {
                "color": "#E0752D",
                "value": 20
              },
              {
                "color": "#56A64B",
                "value": 35
              },
              {
                "color": "#3274D9",
                "value": 85
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
    },
